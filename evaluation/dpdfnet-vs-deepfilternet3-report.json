  "claim_audit": {
    "author_reported_not_independently_reproduced": [
      "The paper's multilingual PESQ, STOI, SI-SNR, DNSMOS, NISQA, and PRISM table.",
      "The paper's DNS4 blind-test scores.",
      "The paper's Ceva NPU realtime factors.",
      "The attribution of part of the gain to OA loss and always-on fine-tuning."
    ],
    "confirmed_from_primary_source": [
      "DPDFNet extends the DeepFilterNet2 lineage with dual-path recurrent blocks.",
      "Its intra stage is bidirectional over frequency and its inter stage is causal over time.",
      "The paper reports OA loss and always-on fine-tuning with 30-40 second sequences.",
      "The official 16 kHz profiles report 2.49-3.54M parameters and 1.35-4.37G MACs for DPDFNet-2/4/8.",
      "The exact 48 kHz HR candidate reports 2.58M parameters and 2.42G MACs.",
      "The official streaming API buffers a 20 ms first window and then emits 10 ms hops."
    ],
    "contradicted_or_narrowed": [
      "DPDFNet is Apache-2.0, not MIT.",
      "The exact local DeepFilterNet3 standard config is about 30 ms by the upstream delay formula, not 40 ms.",
      "DPDFNet is not established as categorically better everywhere; the measured candidate result is limited to author-reported tables and this app's fixed local corpora/gates.",
      "The 1.35-4.37G MAC range describes 16 kHz DPDFNet-2/4/8; the integrated 48 kHz HR DPDFNet-2 is reported at 2.42G MACs."
    ],
    "locally_reproduced_or_measured": [
      "DPDFNet-2 HR passed all four local noisy-speech component gates against both bundled DeepFilterNet3 variants but failed two clean-preservation gates.",
      "The per-file result uses a three-of-four component rule rather than a composite of incompatible raw units.",
      "The production worker path stayed below the 7.5 ms P99 hop and 0.75 RTF gates on this host.",
      "The bundled DeepFilterNet3 LL and standard configs have 10 ms and 30 ms declared algorithmic latency respectively."
    ],
    "primary_sources": [
      "https://arxiv.org/html/2512.16420v2",
      "https://github.com/ceva-ip/DPDFNet",
      "https://raw.githubusercontent.com/ceva-ip/DPDFNet/main/LICENSE",
      "https://github.com/Rikorose/DeepFilterNet"
    ]
  },
