"""Typing surface for the PyO3 extension implemented in ``rust-core``."""

from collections.abc import Mapping, Sequence
from typing import Any

import numpy as np
import numpy.typing as npt


class DeviceInfo:
    name: str
    is_default: bool
    endpoint_id: str | None
    host_api: str
    direction: str
    sample_rate: int | None
    channels: int | None
    name_ordinal: int

    def __repr__(self) -> str: ...


class InputFormats:
    name: str
    endpoint_id: str | None
    is_default: bool
    # (sample format, channels, sample rate)
    default_config: tuple[str, int, int] | None
    # (sample format, channels, lowest rate, highest rate) per supported range
    supported: list[tuple[str, int, int, int]]
    error: str | None


class AudioProcessor:
    """Native audio engine.

    Safe to call from any thread: getters and setters never block on a start,
    stop or recovery in progress, and start, stop and service_recovery release
    the GIL while they run.
    """

    def __init__(self) -> None: ...
    def start(
        self,
        input_device: str | None = None,
        output_device: str | None = None,
        input_device_name_ordinal: int = 0,
        output_device_name_ordinal: int = 0,
        input_device_endpoint_id: str | None = None,
        output_device_endpoint_id: str | None = None,
    ) -> str: ...
    def stop(self) -> None: ...
    def is_running(self) -> bool: ...
    def get_active_input_device(self) -> str | None: ...
    def get_active_input_device_endpoint_id(self) -> str | None: ...
    def get_active_input_device_name_ordinal(self) -> int | None: ...
    def get_active_output_device(self) -> str | None: ...
    def get_active_output_device_endpoint_id(self) -> str | None: ...
    def get_active_output_device_name_ordinal(self) -> int | None: ...
    def sample_rate(self) -> int: ...
    def set_bypass(self, bypass: bool) -> None: ...
    def is_bypass(self) -> bool: ...
    def set_raw_monitor_enabled(self, enabled: bool) -> None: ...
    def is_raw_monitor_enabled(self) -> bool: ...
    def set_input_channel_mode(self, mode: str) -> None: ...
    def get_input_channel_mode(self) -> str: ...
    def set_input_cleanup_mode(self, mode: str) -> None: ...
    def get_input_cleanup_mode(self) -> str: ...
    def get_vad_probability(self) -> float: ...
    def is_vad_available(self) -> bool: ...
    def set_vad_threshold(self, threshold: float) -> None: ...
    def set_vad_hold_time(self, hold_ms: float) -> None: ...
    def set_vad_pre_gain(self, gain: float) -> None: ...
    def set_auto_threshold(self, enabled: bool) -> None: ...
    def get_noise_floor(self) -> float: ...
    def auto_threshold_enabled(self) -> bool: ...
    def vad_pre_gain(self) -> float: ...
    def set_rnnoise_enabled(self, enabled: bool) -> None: ...
    def is_rnnoise_enabled(self) -> bool: ...
    def set_rnnoise_strength(self, strength: float) -> None: ...
    def get_rnnoise_strength(self) -> float: ...
    def set_noise_model(self, model: str) -> bool: ...
    def get_noise_model(self) -> str: ...
    def list_noise_models(self) -> list[tuple[str, str]]: ...
    def set_eq_enabled(self, enabled: bool) -> None: ...
    def is_eq_enabled(self) -> bool: ...
    def get_eq_band_config(
        self, band: int
    ) -> tuple[str, float, float, float, int, bool] | None: ...
    def apply_eq_settings_v2(
        self,
        bands: Sequence[tuple[str, float, float, float, int, bool]],
    ) -> None: ...
    def apply_eq_layers(
        self,
        correction_bands: Sequence[tuple[str, float, float, float, int, bool]],
        tone_bands: Sequence[tuple[str, float, float, float, int, bool]],
    ) -> None: ...
    def apply_deesser_settings(self, settings: dict[str, Any]) -> None: ...
    def apply_compressor_settings(self, settings: dict[str, Any]) -> None: ...
    def apply_gate_settings(self, settings: dict[str, Any]) -> None: ...
    def get_deesser_low_cut_hz(self) -> float: ...
    def get_deesser_high_cut_hz(self) -> float: ...
    def get_deesser_auto_amount(self) -> float: ...
    def get_deesser_gain_reduction_db(self) -> float: ...
    def is_compressor_enabled(self) -> bool: ...
    def get_compressor_release(self) -> float: ...
    def get_compressor_current_release(self) -> float: ...
    def get_compressor_auto_makeup_enabled(self) -> bool: ...
    def get_compressor_current_lufs(self) -> float: ...
    def get_compressor_current_makeup_gain(self) -> float: ...
    def set_limiter_enabled(self, enabled: bool) -> None: ...
    def is_limiter_enabled(self) -> bool: ...
    def set_limiter_ceiling(self, ceiling_db: float) -> None: ...
    def set_limiter_release(self, release_ms: float) -> None: ...
    def set_limiter_careful_output_enabled(self, enabled: bool) -> None: ...
    def get_limiter_effective_ceiling_db(self) -> float: ...
    def get_input_peak_db(self) -> float: ...
    def get_input_rms_db(self) -> float: ...
    def get_output_peak_db(self) -> float: ...
    def get_output_rms_db(self) -> float: ...
    def take_input_peak_since_read(self) -> float:
        """Largest absolute input sample since the previous call, then reset it.

        Linear amplitude, not dB: 0.0 means silence (or nothing since the last
        call), 1.0 is full scale, and a float device can deliver more than 1.0
        (reported unclamped). Convert and clamp in Python. Non-finite samples
        are ignored. The value is held by the realtime thread between calls, so
        a transient between two polls is never missed; the first call after
        ``start`` covers the time since ``start``.

        This is a destructive read (an atomic swap to zero): a second caller,
        such as a setup dialog polling beside the main window, would take the
        peak away from the first. Exactly one object in the Python process may
        call this; it must keep the running maximum and share it with anyone
        else who needs it. A peak published between the read and the reset is
        not lost; it appears in the next call.

        Measured on the mono signal that enters the DSP loop: after channel
        mix-down and any input resampling, before sanitizing, the 80 Hz
        pre-filter and cleanup, in every processing path (including raw
        monitor and bypass). It is therefore not the value ``get_input_peak_db``
        shows, which is taken after the pre-filter and cleanup.
        """
        ...

    def take_output_peak_since_read(self) -> float:
        """Largest absolute sample queued for the output device since the previous call.

        Same semantics as ``take_input_peak_since_read`` (linear amplitude,
        destructive read, single caller). Measured after the final true-peak
        limiter, the output clamp, the non-finite sanitizer and the start-up
        fade, at the output device's sample rate, on samples that were actually
        written to the output queue (samples dropped by a short write are not
        included). With the limiter off the clamp is at 1.0, so this is at most
        1.0. It is taken before the device callback, so it keeps reporting while
        the output is muted or the device is stalled.
        """
        ...

    def take_output_pre_limiter_peak_since_read(self) -> float:
        """Largest absolute sample of the OUT meter tap since the previous call.

        Same semantics as ``take_input_peak_since_read``. Measured where
        ``get_output_peak_db`` is measured: after the compressor, the main
        limiter and makeup, before the final true-peak limiter and clamp, so it
        can exceed 1.0 and is the held counterpart of the OUT meter bar. Use
        ``take_output_peak_since_read`` for what the output actually carries.
        Must be called by the same single reader as the other ``take_*`` methods.
        """
        ...

    def get_input_full_scale_count(self) -> int:
        """Input samples with absolute value >= 0.999 (-0.009 dBFS), cumulative since start.

        Non-destructive and monotonic:
        it restarts at zero on ``start``, any number of readers may call it, and
        each reader takes its own difference between two calls. 0.999 is the
        level ``raw_capture_is_clipped`` uses, and it counts a saturated
        converter's exact +/-1.0 (and 32767/32768) that the older
        ``clip_event_count`` (strictly above 1.0) does not. It rises by one per
        sample, so it cannot tell a single touch of full scale from a flat top;
        ``raw_capture_is_clipped`` needs a run of samples for that. Same
        measurement point as ``take_input_peak_since_read``.
        """
        ...

    def get_output_full_scale_count(self) -> int:
        """Queued output samples with absolute value >= 0.999, cumulative since start.

        Non-destructive and monotonic, same threshold as
        ``get_input_full_scale_count``, same measurement point as
        ``take_output_peak_since_read``. With the limiter on and its ceiling at
        or above 0.999 a hard-limited signal counts too, so judge "full scale
        with the limiter off" together with the limiter setting.
        """
        ...

    def get_compressor_gain_reduction_db(self) -> float: ...
    def get_latency_ms(self) -> float: ...
    def get_engine_latency_ms(self) -> float: ...
    def set_latency_compensation_ms(self, compensation_ms: float) -> None: ...
    def get_input_buffer_smoothed_samples(self) -> int: ...
    def get_output_buffer_samples(self) -> int: ...
    def output_sample_rate(self) -> int: ...
    def output_fixed_buffer_frames(self) -> int: ...
    def input_fixed_buffer_frames(self) -> int: ...
    def get_dsp_time_smoothed_ms(self) -> float: ...
    def get_buffer_smoothed_samples(self) -> int: ...
    def reset_dropped_samples(self) -> None: ...
    def get_input_callback_age_ms(self) -> int:
        """Milliseconds since the input callback last ran; ``2**64 - 1`` before its first call."""
        ...

    def get_output_callback_age_ms(self) -> int:
        """Milliseconds since the output callback last ran; ``2**64 - 1`` before its first call."""
        ...

    def noise_backend_failed(self) -> bool: ...
    def noise_backend_error(self) -> str | None: ...
    def set_recovery_suppressed(self, suppressed: bool) -> None: ...
    def is_recovery_suppressed(self) -> bool: ...
    def get_runtime_diagnostics(self) -> dict[str, Any]: ...
    def service_recovery(self) -> bool | None: ...
    def is_recovery_requested(self) -> bool: ...
    def is_recovering(self) -> bool: ...
    def get_stream_restart_count(self) -> int: ...
    def get_last_stream_error(self) -> str | None: ...
    def get_last_restart_reason(self) -> str | None: ...
    def start_raw_recording(
        self, duration_secs: float, before_cleanup: bool = False
    ) -> None: ...
    def stop_raw_recording(self) -> npt.NDArray[np.float32]: ...
    def is_recording_complete(self) -> bool: ...
    def recording_progress(self) -> float: ...
    def recording_level_db(self) -> float: ...
    def set_output_mute(self, muted: bool) -> None: ...
    def queue_output_probe(self, samples: npt.NDArray[np.float32]) -> None: ...
    def is_output_probe_complete(self) -> bool: ...
    def cancel_output_probe(self) -> None: ...


